<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditNotaActivity" >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginBottom="60dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <EditText
                android:id="@+id/editTextTituloNwNota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="@string/editTextHintAs"
                android:inputType="text|textMultiLine|textCapSentences"
                android:maxLength="60"
                android:singleLine="false"
                android:textSize="24sp"
                android:textStyle="bold"
                android:importantForAutofill="no"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/libretas"
                    app:srcCompat="@mipmap/ic_libreta3_foreground" />

                <Spinner
                    android:id="@+id/spinnerOpcionLibretas"
                    android:layout_width="wrap_content"
                    android:layout_height="31dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="15sp"
                    android:maxLength="10"
                    android:layout_marginStart="8dp" />

                <ImageButton
                    android:id="@+id/buttonEtiquetas"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/etiquetas"
                    app:srcCompat="@mipmap/ic_etiqueta2_foreground" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"
                    tools:text="0"/>

            </LinearLayout>

            <EditText
                android:id="@+id/editTextContenidoNwNota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="@string/editTextHintAs2"
                android:inputType="text|textMultiLine|textCapSentences"
                android:singleLine="false"
                android:importantForAutofill="no"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="15dp"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        android:background="@color/color_menu_buttom"
        app:menu="@menu/bottom_menu_edit_nota" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
