<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EditNotaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginBottom="56dp">

        <EditText
            android:id="@+id/editTextTituloNwNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/editTextHintAs"
            android:importantForAutofill="no"
            android:inputType="text|textCapSentences|textMultiLine"
            android:maxLength="60"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textSize="24sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLibreta"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    app:chipIcon="@drawable/ic_libretas"
                    app:chipIconTint="@color/on_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEtiquetas"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    app:chipIcon="@drawable/ic_etiquetas"
                    app:chipIconTint="@color/on_surface" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <View
            style="@style/Divider"
            android:layout_marginTop="4dp" />

        <HorizontalScrollView
            android:id="@+id/scrollAdjuntos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonAnadirAdjunto"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/adjuntar_imagen"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_adjuntar"
                    app:tint="?attr/colorOnSurface" />

                <LinearLayout
                    android:id="@+id/contenedorAdjuntos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <EditText
                android:id="@+id/editTextContenidoNwNota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top"
                android:hint="@string/editTextHintAs2"
                android:importantForAutofill="no"
                android:inputType="text|textMultiLine|textCapSentences"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:textSize="16sp" />

        </ScrollView>

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/barraFormato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/buttonNegrita"
                style="@style/BotonFormato"
                android:contentDescription="@string/negrita"
                app:srcCompat="@drawable/ic_negrita" />

            <ImageButton
                android:id="@+id/buttonCursiva"
                style="@style/BotonFormato"
                android:contentDescription="@string/cursiva"
                app:srcCompat="@drawable/ic_cursiva" />

            <ImageButton
                android:id="@+id/buttonTachado"
                style="@style/BotonFormato"
                android:contentDescription="@string/tachado"
                app:srcCompat="@drawable/ic_tachado" />

            <ImageButton
                android:id="@+id/buttonCodigo"
                style="@style/BotonFormato"
                android:contentDescription="@string/codigo"
                app:srcCompat="@drawable/ic_codigo" />

            <ImageButton
                android:id="@+id/buttonEncabezado"
                style="@style/BotonFormato"
                android:contentDescription="@string/encabezado"
                app:srcCompat="@drawable/ic_encabezado" />

            <ImageButton
                android:id="@+id/buttonCita"
                style="@style/BotonFormato"
                android:contentDescription="@string/cita"
                app:srcCompat="@drawable/ic_cita" />

            <ImageButton
                android:id="@+id/buttonVinietas"
                style="@style/BotonFormato"
                android:contentDescription="@string/viñetas"
                app:srcCompat="@drawable/ic_vinietas" />

            <ImageButton
                android:id="@+id/buttonListaNumerada"
                style="@style/BotonFormato"
                android:contentDescription="@string/lista_numerada"
                app:srcCompat="@drawable/ic_lista_numerada" />

            <ImageButton
                android:id="@+id/buttonCasilla"
                style="@style/BotonFormato"
                android:contentDescription="@string/casilla"
                app:srcCompat="@drawable/ic_casilla" />

            <ImageButton
                android:id="@+id/buttonEnlace"
                style="@style/BotonFormato"
                android:contentDescription="@string/enlace"
                app:srcCompat="@drawable/ic_enlace" />

            <ImageButton
                android:id="@+id/buttonSeparador"
                style="@style/BotonFormato"
                android:contentDescription="@string/separador"
                app:srcCompat="@drawable/ic_separador" />

        </LinearLayout>
    </HorizontalScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
